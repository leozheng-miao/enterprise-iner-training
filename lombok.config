# 让 Lombok 在生成构造函数时，把以下注解从字段复制到构造函数参数。
# 解决经典坑：@Qualifier 在 final 字段 + @RequiredArgsConstructor 时，
# Lombok 默认不复制 → Spring 注入按 @Primary 走错 bean。
lombok.copyableAnnotations += org.springframework.beans.factory.annotation.Qualifier
lombok.copyableAnnotations += jakarta.annotation.Resource
lombok.copyableAnnotations += jakarta.inject.Named

# 标记项目级 lombok.config（停止向上搜索父目录）
config.stopBubbling = true
