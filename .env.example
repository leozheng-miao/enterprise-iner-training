# 本地环境变量模板。
# 用法：cp .env.example .env，把下面的占位值替换为真实 secret。
# .env 文件被 .gitignore，不会提交。
#
# subagent / 命令行启动方式：
#   set -a; source .env; set +a; ./mvnw spring-boot:run
# IDE：在 Run/Debug Configuration → Environment variables 填同名变量；
#      或安装 EnvFile 插件让 IDEA 自动加载 .env。

# 至少 32 字节（>= 256-bit）。生成：openssl rand -base64 48
JWT_SECRET=replace-me-with-openssl-rand-base64-48

# 阿里云 DashScope API key (https://dashscope.console.aliyun.com)
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

OPENAI_API_KEY=
DEEPSEEK_API_KEY=
VLLM_BASE_URL=
VLLM_MODEL=
